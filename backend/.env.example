# ============================================================================
# .env.example — a TEMPLATE showing which environment variables the app needs.
#
# WHY two files (.env.example vs .env)?
#   - .env.example  -> committed to git. Documents what's needed. No real secrets.
#   - .env          -> IGNORED by git. Holds YOUR real secrets. Never shared.
#
# To set up: copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ============================================================================

# Which environment config to load: development | testing | production
FLASK_ENV=development

# Port the backend listens on. Default 5001 (macOS reserves 5000 for AirPlay).
PORT=5001

# Secret used to sign tokens/sessions. In production use a long random string,
# e.g. generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Database connection string.
# Local development default (SQLite, zero setup):
DATABASE_URL=sqlite:///gateway_dev.db
# Later, for MySQL it will look like:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/gateway
